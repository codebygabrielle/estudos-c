#include <stdio.h>

int main() {
    float pes, polegadas, jardas, milhas;

    printf("Digite a medida em pes: ");
    scanf("%f", &pes);

    polegadas = pes * 12;
    jardas = pes / 3;
    milhas = jardas / 1760;

    printf("a) Polegadas: %.2f\n", polegadas);
    printf("b) Jardas: %.2f\n", jardas);
    printf("c) Milhas: %.6f\n", milhas);

    return 0;
}
