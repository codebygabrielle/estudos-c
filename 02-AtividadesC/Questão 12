#include <stdio.h>
#include <math.h>

int main() {
    float numero1, numero2, resultado;

    printf("Digite o primeiro numero: ");
    scanf("%f", &numero1);

    printf("Digite o segundo numero: ");
    scanf("%f", &numero2);

    resultado = pow(numero1, numero2);

    printf("%.2f elevado a %.2f = %.2f\n", numero1, numero2, resultado);

    return 0;
}
